{
  "_comment": "Template-seeded arm (src/adock/template). Exploratory; values are first choices, not tuned unless noted in reports/template_seeded.md.",
  "pdb_mirror": "${ADOCK_PDB_MIRROR}",
  "seqres": "derived_data/pdb_seqres.txt",
  "entries_idx": "derived_data/index/entries.idx",
  "mmcif_dir": "data/structures/divided/mmCIF",
  "ccd_dir": "refdata/chem_comp",
  "sifts_chain_uniprot": "data/sifts/pdb_chain_uniprot.tsv.gz",
  "artifact_ccd": "results/splits/artifact_ccd_codes.txt",
  "workdir": "${ADOCK_WORK}/template",
  "mmseqs": "${ADOCK_WORK}/tools/mmseqs/bin/mmseqs",
  "_mmseqs_note": "installed by scripts/install_mmseqs.sh",
  "mmseqs_threads": 6,
  "mmseqs_sensitivity": 7.5,
  "mmseqs_evalue": 1e-3,
  "mmseqs_max_seqs": 2000,
  "min_seqres_len": 30,
  "seqid_tier3_max": 0.30,
  "_seqid_note": "T3 excludes templates with >= 30% identity (DESIGN.md leakage rule threshold); identity = MMseqs2 fident of the local alignment",
  "max_entries_per_stream": 30,
  "_streams_note": "candidate entries parsed per query: up to this many for each stream (all / other UniProt / <30% id), sorted by bitscore, ties broken by a seeded hash of the entry id",
  "stream_hash_seed": 0,
  "min_pocket_aligned": 5,
  "min_pocket_aligned_frac": 0.5,
  "max_pocket_ca_rmsd": 3.0,
  "min_template_heavy": 6,
  "lig_in_box_frac": 0.7,
  "max_lig_centroid_to_box_center": 7.0,
  "lig_contact_dist": 4.5,
  "max_templates_per_tier": 10,
  "min_mcs_atoms": 6,
  "mcs_timeout_s": 2,
  "n_embed_per_template": 2,
  "embed_max_mcs_rmsd": 1.0,
  "max_seed_templates": 6,
  "seed_replicas": 2,
  "use_o3a_fallback": false,
  "o3a_n_conformers": 10
}
